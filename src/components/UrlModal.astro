---
interface Props {
  url: string;
  isOpen: boolean;
}

const { url, isOpen } = Astro.props;
---

<div id="url-modal" class={`fixed inset-0 bg-black/50 flex items-center justify-center z-50 ${isOpen ? '' : 'hidden'}`}>
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 max-w-2xl w-full mx-4 shadow-2xl">
    <h2 class="text-xl font-semibold text-slate-100 mb-4">Your Shareable URL</h2>
    <div class="flex gap-2 mb-4">
      <input
        type="text"
        id="generated-url"
        class="flex-1 bg-slate-950 text-slate-100 px-4 py-2 rounded-lg border border-slate-700 font-mono text-sm"
        readonly
        value={url}
      />
      <button
        id="copy-url-btn"
        class="bg-gray-800 text-gray-300 border border-gray-700 hover:bg-gray-700 hover:text-white transition-colors rounded px-3 py-1.5 text-sm font-mono"
      >
        Copy
      </button>
    </div>
    <p class="text-sm text-slate-400 mb-4">
      This URL contains your compressed Markdown content. Share it with anyone to let them view your document.
    </p>
    <div class="flex flex-col sm:flex-row justify-between items-stretch sm:items-center gap-3">
      <button
        id="modal-download-md-btn"
        type="button"
        class="bg-gray-800 text-slate-300 border border-gray-700 hover:bg-gray-700 hover:text-white transition-colors rounded px-3 py-1.5 text-sm font-mono flex items-center justify-center gap-1.5"
        title="Download Markdown file"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span id="modal-download-md-label">Download .md</span>
      </button>
      <div class="flex items-center justify-end gap-2">
        <button
          id="open-url-btn"
          class="bg-green-600 text-white hover:bg-green-500 font-mono transition-colors rounded px-4 py-2 text-sm"
        >
          Open URL
        </button>
        <button
          id="close-modal-btn"
          class="bg-gray-800 text-gray-300 border border-gray-700 hover:bg-gray-700 hover:text-white transition-colors rounded px-3 py-1.5 text-sm font-mono"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { exportMarkdown } from '../utils/editor/export-markdown';

  const urlModal = document.getElementById('url-modal');
  const generatedUrl = document.getElementById('generated-url') as HTMLInputElement | null;
  const copyUrlBtn = document.getElementById('copy-url-btn');
  const openUrlBtn = document.getElementById('open-url-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');

  function closeModal() {
    if (urlModal) {
      urlModal.classList.add('hidden');
    }
  }

  async function copyUrl() {
    if (!generatedUrl) return;
    try {
      await navigator.clipboard.writeText(generatedUrl.value);
      if (copyUrlBtn) {
        copyUrlBtn.textContent = 'Copied!';
        setTimeout(() => {
          if (copyUrlBtn) copyUrlBtn.textContent = 'Copy';
        }, 2000);
      }
    } catch (error) {
      console.error('Copy failed:', error);
    }
  }

  function openUrl() {
    if (generatedUrl) {
      window.open(generatedUrl.value, '_blank', 'noopener,noreferrer');
    }
  }

  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeModal);
  }

  if (copyUrlBtn) {
    copyUrlBtn.addEventListener('click', copyUrl);
  }

  if (openUrlBtn) {
    openUrlBtn.addEventListener('click', openUrl);
  }

  const modalDownloadMdBtn = document.getElementById('modal-download-md-btn');
  if (modalDownloadMdBtn) {
    modalDownloadMdBtn.addEventListener('click', () => {
      const editor = document.getElementById('markdown-editor') as HTMLTextAreaElement | null;
      if (editor) {
        exportMarkdown(editor.value);
        const label = modalDownloadMdBtn.querySelector('#modal-download-md-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Downloaded!';
          modalDownloadMdBtn.classList.add('text-emerald-400');
          setTimeout(() => {
            label.textContent = original;
            modalDownloadMdBtn.classList.remove('text-emerald-400');
          }, 2000);
        }
      }
    });
  }

  if (urlModal) {
    urlModal.addEventListener('click', (e) => {
      if (e.target === urlModal) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && urlModal && !urlModal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
