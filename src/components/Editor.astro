---
import Header from './Header.astro';
import UrlModal from './UrlModal.astro';
---
<div id="editor-mode" class="h-screen flex flex-col">
  <Header />

  <!-- Full-Width Formatting Toolbar -->
  <div class="bg-gray-800 border-b border-slate-700 px-4 py-2 flex justify-between items-center">
    <div class="flex gap-1 flex-wrap">
      <!-- Mobile View Toggle Buttons -->
      <div class="flex md:hidden gap-1 mr-2">
        <button id="view-edit-btn" class="view-toggle-btn bg-green-600 text-white px-3 py-1.5 rounded text-sm font-medium transition-colors" aria-label="Edit view">
          Edit
        </button>
        <button id="view-preview-btn" class="view-toggle-btn bg-slate-700 text-slate-300 hover:bg-slate-600 px-3 py-1.5 rounded text-sm font-medium transition-colors" aria-label="Preview view">
          Preview
        </button>
      </div>
      <button data-format="bold" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Bold (Ctrl+B)" aria-label="Bold text">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
      </button>
      <button data-format="italic" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Italic (Ctrl+I)" aria-label="Italic text">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
      </button>
      <button data-format="h1" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Heading 1" aria-label="Heading 1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/><path d="m17 10 3-2v10"/></svg>
      </button>
      <button data-format="h2" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Heading 2" aria-label="Heading 2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/><path d="M21 18h-4c0-4 4-3 4-6 0-1.5-2-2.5-4-1"/></svg>
      </button>
      <button data-format="link" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Link" aria-label="Insert link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      </button>
      <button data-format="list" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Bullet List" aria-label="Insert bullet list">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </button>
      <button data-format="table" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Table" aria-label="Insert table">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
      </button>
      <button data-format="tasklist" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Task List" aria-label="Insert task list">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      </button>
      <button data-format="blockquote" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Blockquote" aria-label="Insert blockquote">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
      </button>
      <button data-format="footnote" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Footnote" aria-label="Insert footnote">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17a5 5 0 0 0 5-5"/><path d="M12 17a5 5 0 0 1-5-5"/><path d="M12 17v4"/><path d="M12 3v4"/><path d="M7 7a5 5 0 0 1 5-5"/><path d="M17 7a5 5 0 0 0-5-5"/></svg>
      </button>
      <button data-format="hr" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors" title="Horizontal Rule" aria-label="Insert horizontal rule">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>
    <div class="flex items-center gap-3">
      <label class="text-sm text-slate-400 hidden md:block">Background Theme</label>
      <select id="theme-selector" class="bg-slate-950 text-slate-100 px-3 py-2 rounded-lg border border-slate-700 text-sm focus:outline-none focus:border-blue-500">
        <option value="bg-slate-950" selected>Default Dark</option>
        <option value="bg-gray-900">Deep Gray</option>
        <option value="bg-blue-950">Midnight Blue</option>
      </select>
    </div>
  </div>

  <!-- Split View -->
  <div class="flex-1 flex overflow-hidden">
    <!-- Left Pane - Editor -->
    <div id="editor-pane" class="w-full md:w-1/2 flex-col border-r border-slate-800 hidden">
      <textarea
        id="markdown-editor"
        class="flex-1 bg-slate-950 text-slate-100 p-6 font-mono text-sm resize-none focus:outline-none"
        placeholder="Start writing your Markdown here..."
        aria-label="Markdown editor"
      ></textarea>
    </div>

    <!-- Right Pane - Preview -->
    <div id="preview-pane" class="w-full md:w-1/2 bg-slate-950 overflow-auto hidden">
      <div class="max-w-4xl mx-auto px-6 py-12">
        <div id="markdown-preview" class="prose prose-invert max-w-full break-words"></div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="bg-slate-900 border-t border-slate-800 px-6 py-4 flex justify-start items-center">
    <span class="text-sm text-slate-400" id="char-count">0 characters</span>
  </div>

  <UrlModal url="" isOpen={false} />
</div>

<script>
  import { parse } from '../utils/markdown';
  import { debounce } from '../utils/debounce';
  import { insertMarkdown } from '../utils/editor/markdown-formatter';
  import { saveDraft, restoreDraft } from '../utils/editor/draft-persistence';
  import { generateUrl, closeModal } from '../utils/editor/url-generator';

  const markdownEditor = document.getElementById('markdown-editor') as HTMLTextAreaElement | null;
  const markdownPreview = document.getElementById('markdown-preview') as HTMLElement | null;
  const charCount = document.getElementById('char-count') as HTMLElement | null;
  const generateUrlBtn = document.getElementById('generate-url-btn') as HTMLButtonElement | null;
  const themeSelector = document.getElementById('theme-selector') as HTMLSelectElement | null;
  const previewPane = document.getElementById('preview-pane') as HTMLElement | null;
  const editorPane = document.getElementById('editor-pane') as HTMLElement | null;
  const formatButtons = document.querySelectorAll('.format-btn');
  const urlModal = document.getElementById('url-modal') as HTMLElement | null;
  const generatedUrl = document.getElementById('generated-url') as HTMLInputElement | null;
  const viewEditBtn = document.getElementById('view-edit-btn') as HTMLButtonElement | null;
  const viewPreviewBtn = document.getElementById('view-preview-btn') as HTMLButtonElement | null;

  let mediaQuery: MediaQueryList | null = null;

  // Mobile view toggle logic
  function setMobileView(view: 'edit' | 'preview') {
    if (!editorPane || !previewPane || !viewEditBtn || !viewPreviewBtn) return;

    if (view === 'edit') {
      // Editor pane: show with flex
      editorPane.classList.remove('hidden');
      editorPane.classList.add('flex');
      // Preview pane: hide
      previewPane.classList.add('hidden');
      previewPane.classList.remove('flex');
      // Update button states
      viewEditBtn.classList.remove('bg-slate-700', 'text-slate-300', 'hover:bg-slate-600');
      viewEditBtn.classList.add('bg-green-600', 'text-white');
      viewPreviewBtn.classList.remove('bg-green-600', 'text-white');
      viewPreviewBtn.classList.add('bg-slate-700', 'text-slate-300', 'hover:bg-slate-600');
    } else {
      // Editor pane: hide
      editorPane.classList.add('hidden');
      editorPane.classList.remove('flex');
      // Preview pane: show with flex
      previewPane.classList.remove('hidden');
      previewPane.classList.add('flex');
      // Update button states
      viewPreviewBtn.classList.remove('bg-slate-700', 'text-slate-300', 'hover:bg-slate-600');
      viewPreviewBtn.classList.add('bg-green-600', 'text-white');
      viewEditBtn.classList.remove('bg-green-600', 'text-white');
      viewEditBtn.classList.add('bg-slate-700', 'text-slate-300', 'hover:bg-slate-600');
      // Update preview when switching to preview view
      updatePreview();
    }
  }

  // Responsive view handling
  function handleResponsiveView(e: MediaQueryListEvent | MediaQueryList) {
    const isDesktop = e.matches;

    if (isDesktop) {
      // Desktop: show both panes side-by-side
      if (editorPane) {
        editorPane.classList.remove('hidden');
        editorPane.classList.add('flex');
      }
      if (previewPane) {
        previewPane.classList.remove('hidden');
        previewPane.classList.add('flex');
      }
    } else {
      // Mobile: default to edit mode (single pane)
      setMobileView('edit');
    }
  }

  async function updatePreview() {
    if (!markdownEditor || !markdownPreview || !charCount) return;
    const markdown = markdownEditor.value;
    charCount.textContent = `${markdown.length} characters`;
    markdownPreview.innerHTML = await parse(markdown);
  }

  function updatePreviewTheme() {
    if (!themeSelector || !previewPane) return;
    const theme = themeSelector.value;
    previewPane.classList.remove('bg-slate-950', 'bg-gray-900', 'bg-blue-950');
    previewPane.classList.add(theme);
    if (typeof window !== 'undefined') {
      localStorage.setItem('md2web_draft_theme', theme);
    }
  }

  const debouncedUpdatePreview = debounce(updatePreview, 300);
  const debouncedSaveDraft = debounce(() => {
    if (markdownEditor) saveDraft(markdownEditor);
  }, 1000);

  if (markdownEditor) {
    markdownEditor.addEventListener('input', () => {
      debouncedUpdatePreview();
      debouncedSaveDraft();
    });

    markdownEditor.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.ctrlKey || e.metaKey) {
        if (e.key === 'b') {
          e.preventDefault();
          insertMarkdown(markdownEditor, 'bold', updatePreview);
        } else if (e.key === 'i') {
          e.preventDefault();
          insertMarkdown(markdownEditor, 'italic', updatePreview);
        }
      }
    });
  }

  if (themeSelector) {
    themeSelector.addEventListener('change', updatePreviewTheme);
  }

  // Mobile view toggle event listeners
  if (viewEditBtn) {
    viewEditBtn.addEventListener('click', () => setMobileView('edit'));
  }

  if (viewPreviewBtn) {
    viewPreviewBtn.addEventListener('click', () => setMobileView('preview'));
  }

  if (generateUrlBtn) {
    generateUrlBtn.addEventListener('click', () => {
      if (markdownEditor && themeSelector && urlModal && generatedUrl) {
        generateUrl(markdownEditor, themeSelector, urlModal, generatedUrl);
      }
    });
  }

  if (urlModal) {
    urlModal.addEventListener('click', (e: MouseEvent) => {
      if (e.target === urlModal) {
        closeModal(urlModal);
      }
    });
  }

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && urlModal && !urlModal.classList.contains('hidden')) {
      closeModal(urlModal);
    }
  });

  formatButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const format = btn.getAttribute('data-format');
      if (format && markdownEditor) insertMarkdown(markdownEditor, format, updatePreview);
    });
  });

  // Event listener cleanup
  function cleanup() {
    if (markdownEditor) {
      markdownEditor.removeEventListener('input', () => {
        debouncedUpdatePreview();
        debouncedSaveDraft();
      });
      markdownEditor.removeEventListener('keydown', (e: KeyboardEvent) => {
        if (e.ctrlKey || e.metaKey) {
          if (e.key === 'b') {
            e.preventDefault();
            insertMarkdown(markdownEditor, 'bold', updatePreview);
          } else if (e.key === 'i') {
            e.preventDefault();
            insertMarkdown(markdownEditor, 'italic', updatePreview);
          }
        }
      });
    }
    if (themeSelector) {
      themeSelector.removeEventListener('change', updatePreviewTheme);
    }
    if (viewEditBtn) {
      viewEditBtn.removeEventListener('click', () => setMobileView('edit'));
    }
    if (viewPreviewBtn) {
      viewPreviewBtn.removeEventListener('click', () => setMobileView('preview'));
    }
    if (generateUrlBtn) {
      generateUrlBtn.removeEventListener('click', () => {
        if (markdownEditor && themeSelector && urlModal && generatedUrl) {
          generateUrl(markdownEditor, themeSelector, urlModal, generatedUrl);
        }
      });
    }
    if (urlModal) {
      urlModal.removeEventListener('click', (e: MouseEvent) => {
        if (e.target === urlModal) {
          closeModal(urlModal);
        }
      });
    }
    if (mediaQuery) {
      mediaQuery.removeEventListener('change', handleResponsiveView);
    }
    document.removeEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && urlModal && !urlModal.classList.contains('hidden')) {
        closeModal(urlModal);
      }
    });
  }

  window.addEventListener('beforeunload', cleanup);

  // Initialize
  if (typeof window !== 'undefined') {
    updatePreviewTheme();
    if (markdownEditor) {
      restoreDraft(markdownEditor, themeSelector, updatePreview, updatePreviewTheme);
    }

    // Set up responsive view listener
    mediaQuery = window.matchMedia('(min-width: 768px)');
    mediaQuery.addEventListener('change', handleResponsiveView);

    // Initial view setup
    handleResponsiveView(mediaQuery);
  }
</script>
