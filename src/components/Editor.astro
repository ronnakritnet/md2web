---
import Header from './Header.astro';
import Toolbar from './Toolbar.astro';
import EditorPane from './EditorPane.astro';
import PreviewPane from './PreviewPane.astro';
import UrlModal from './UrlModal.astro';
---
<div id="editor-mode" class="h-screen flex flex-col">
  <Header />

  <Toolbar id="toolbar" class="w-full" />

  <!-- Main Content -->
  <main class="flex-1 flex overflow-hidden">
    <EditorPane />
    <PreviewPane />
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 border-t border-gray-700 px-6 py-4 flex justify-between items-center">
    <span class="text-sm text-slate-400" id="char-count">0 characters</span>
    <a
      href="https://github.com/ronnakritnet/md2web"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-sm text-slate-400 hover:text-emerald-400 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      GitHub
    </a>
  </footer>

  <UrlModal url="" isOpen={false} />
</div>

<script>
  import { parse } from '../utils/markdown';
  import { debounce } from '../utils/debounce';
  import { insertMarkdown } from '../utils/editor/markdown-formatter';
  import { handleEditorKeyDown } from '../utils/editor/keyboard-shortcuts';
  import { saveDraft, restoreDraft } from '../utils/editor/draft-persistence';
  import { generateUrl } from '../utils/editor/url-generator';
  import { exportMarkdown } from '../utils/editor/export-markdown';
  import { setMobileView, setupResponsiveView } from '../utils/editor/responsive-view';

  const markdownEditor = document.getElementById('markdown-editor') as HTMLTextAreaElement | null;
  const markdownPreview = document.getElementById('markdown-preview') as HTMLElement | null;
  const charCount = document.getElementById('char-count') as HTMLElement | null;
  const generateUrlBtn = document.getElementById('generate-url-btn') as HTMLButtonElement | null;
  const exportMdBtn = document.getElementById('export-md-btn') as HTMLButtonElement | null;
  const previewPane = document.getElementById('preview-pane') as HTMLElement | null;
  const editorPane = document.getElementById('editor-pane') as HTMLElement | null;
  const formattingTools = document.getElementById('formatting-tools') as HTMLElement | null;
  const colorSwatchesContainer = document.getElementById('color-swatches-container') as HTMLElement | null;
  const formatButtons = document.querySelectorAll('.format-btn');
  const urlModal = document.getElementById('url-modal') as HTMLElement | null;
  const generatedUrl = document.getElementById('generated-url') as HTMLInputElement | null;
  const mobileEditBtn = document.getElementById('mobile-edit-btn') as HTMLButtonElement | null;
  const mobilePreviewBtn = document.getElementById('mobile-preview-btn') as HTMLButtonElement | null;

  let currentColor = '#0f172a';

  async function updatePreview() {
    if (!markdownEditor || !markdownPreview || !charCount) return;
    const markdown = markdownEditor.value;
    charCount.textContent = `${markdown.length} characters`;
    markdownPreview.innerHTML = await parse(markdown);
  }

  function updatePreviewTheme(color?: string) {
    if (!previewPane) return;
    
    let themeColor = color;
    
    // If no color provided, try to get from localStorage or use default
    if (!themeColor && typeof window !== 'undefined') {
      themeColor = localStorage.getItem('md2web_draft_color') || '#0f172a';
    }
    
    if (themeColor) {
      currentColor = themeColor;
      previewPane.style.backgroundColor = themeColor;
      if (typeof window !== 'undefined') {
        localStorage.setItem('md2web_draft_color', themeColor);
      }
    }
  }

  const debouncedUpdatePreview = debounce(updatePreview, 300);
  const debouncedSaveDraft = debounce(() => {
    if (markdownEditor) saveDraft(markdownEditor);
  }, 1000);

  if (markdownEditor) {
    markdownEditor.addEventListener('input', () => {
      debouncedUpdatePreview();
      debouncedSaveDraft();
    });

    markdownEditor.addEventListener('keydown', (e: KeyboardEvent) => {
      handleEditorKeyDown(e, markdownEditor, updatePreview);
    });
  }

  // Listen for color changes from ColorSwatches component
  document.addEventListener('colorchange', (e: Event) => {
    const customEvent = e as CustomEvent<{ color: string }>;
    if (customEvent.detail && customEvent.detail.color) {
      currentColor = customEvent.detail.color;
      updatePreviewTheme(currentColor);
    }
  });

  // Mobile view toggle event listeners
  if (mobileEditBtn && mobilePreviewBtn && editorPane && previewPane && formattingTools && colorSwatchesContainer) {
    const responsiveElements = {
      editorPane,
      previewPane,
      viewEditBtn: mobileEditBtn,
      viewPreviewBtn: mobilePreviewBtn,
      formattingTools,
      colorSwatchesContainer
    };
    const responsiveOptions = { updatePreview };

    mobileEditBtn.addEventListener('click', () => {
      try {
        setMobileView(responsiveElements, 'edit', responsiveOptions);
      } catch (error) {
        console.error('Error switching to edit mode:', error);
      }
    });
    mobilePreviewBtn.addEventListener('click', () => {
      try {
        setMobileView(responsiveElements, 'preview', responsiveOptions);
      } catch (error) {
        console.error('Error switching to preview mode:', error);
      }
    });
  }

  if (generateUrlBtn) {
    generateUrlBtn.addEventListener('click', () => {
      if (markdownEditor && urlModal && generatedUrl) {
        generateUrl(markdownEditor, currentColor, urlModal, generatedUrl);
      }
    });
  }

  if (exportMdBtn) {
    exportMdBtn.addEventListener('click', () => {
      if (!markdownEditor) return;
      const markdown = markdownEditor.value;
      exportMarkdown(markdown);

      const label = exportMdBtn.querySelector('#export-md-label');
      if (label) {
        const originalHtml = label.innerHTML;
        label.innerHTML = '<span class="text-emerald-400">Exported!</span>';
        exportMdBtn.classList.add('border-emerald-500');
        setTimeout(() => {
          label.innerHTML = originalHtml;
          exportMdBtn.classList.remove('border-emerald-500');
        }, 2000);
      }
    });
  }

  formatButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const format = btn.getAttribute('data-format');
      if (format && markdownEditor) insertMarkdown(markdownEditor, format, updatePreview);
    });
  });

  // Initialize
  if (typeof window !== 'undefined') {
    updatePreviewTheme();
    if (markdownEditor) {
      restoreDraft(markdownEditor, updatePreview, updatePreviewTheme);
    }

    // Set up responsive view listener
    if (editorPane && previewPane && formattingTools && colorSwatchesContainer && mobileEditBtn && mobilePreviewBtn) {
      const responsiveElements = {
        editorPane,
        previewPane,
        viewEditBtn: mobileEditBtn,
        viewPreviewBtn: mobilePreviewBtn,
        formattingTools,
        colorSwatchesContainer
      };
      const responsiveOptions = { updatePreview };
      try {
        setupResponsiveView(responsiveElements, responsiveOptions);
      } catch (error) {
        console.error('Error setting up responsive view:', error);
      }
    }
  }
</script>
