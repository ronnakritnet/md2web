---
---

<header class="bg-gray-900 border-b border-gray-700 px-4 py-3 flex justify-between items-center">
  <div class="flex items-center gap-2">
    <img src="/icon.svg" alt="md2web logo" class="w-7 h-7" />
    <h1 class="text-lg font-bold text-green-400 font-mono tracking-tight">
      md2web<span class="text-sm font-normal lowercase">.ronnakrit.net</span>
    </h1>
  </div>
  <div class="flex items-center gap-2">
    <button
      id="export-md-btn"
      type="button"
      class="bg-gray-800 text-slate-300 border border-gray-700 rounded hover:bg-gray-700 hover:text-white hover:border-gray-600 transition-colors duration-200 font-mono px-3 py-1.5 text-sm flex items-center gap-1.5 shadow-sm"
      title="Download as Markdown (.md)"
      aria-label="Export Markdown file"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span id="export-md-label">Export<span class="hidden sm:inline"> .md</span></span>
    </button>
    <button
      id="generate-url-btn"
      type="button"
      class="bg-gray-800 text-green-400 border border-green-600 rounded hover:bg-gray-700 hover:border-green-400 transition-colors duration-200 font-mono px-3 md:px-4 py-1.5 text-sm flex items-center gap-1.5 shadow-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <span>Generate<span class="hidden md:inline"> md2web</span></span>
    </button>
  </div>
</header>
