---
import ColorSwatches from './ColorSwatches.astro';

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---
<!-- Full-Width Formatting Toolbar -->
<div id={id} class={`bg-gray-800 border-b border-gray-700 px-2 sm:px-4 py-2 flex flex-wrap sm:flex-row items-center gap-2 w-full ${className || ''}`} style="display: flex !important; align-items: center !important;">
  <!-- Mobile Edit/Preview Toggle -->
  <div class="flex items-center gap-1 w-full sm:w-auto sm:max-w-[240px] p-0.5 bg-gray-900/60 border border-gray-700/60 rounded-lg md:hidden flex-shrink-0">
    <button
      id="mobile-edit-btn"
      class="w-1/2 flex items-center justify-center gap-1.5 py-1.5 px-3 text-xs font-semibold rounded-md bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 shadow-sm pointer-events-none"
      aria-label="Edit mode"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
      <span>Edit</span>
    </button>
    <button
      id="mobile-preview-btn"
      class="w-1/2 flex items-center justify-center gap-1.5 py-1.5 px-3 text-xs font-medium rounded-md text-gray-400 hover:text-gray-200 bg-transparent border-transparent"
      aria-label="Preview mode"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      <span>Preview</span>
    </button>
  </div>
  <!-- Left Group: Formatting Buttons -->
  <div id="formatting-tools" class="flex items-center gap-1 flex-wrap sm:flex-nowrap overflow-x-auto sm:overflow-visible min-w-0 flex-1 w-full sm:w-auto">
    <button data-format="bold" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Bold (Ctrl+B)" aria-label="Bold text">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
    </button>
    <button data-format="italic" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Italic (Ctrl+I)" aria-label="Italic text">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg>
    </button>
    <button data-format="h1" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Heading 1" aria-label="Heading 1">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/><path d="m17 10 3-2v10"/></svg>
    </button>
    <button data-format="h2" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Heading 2" aria-label="Heading 2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h8"/><path d="M4 18V6"/><path d="M12 18V6"/><path d="M21 18h-4c0-4 4-3 4-6 0-1.5-2-2.5-4-1"/></svg>
    </button>
    <button data-format="link" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Link" aria-label="Insert link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    </button>
    <button data-format="list" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Bullet List" aria-label="Insert bullet list">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    </button>
    <button data-format="table" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Table" aria-label="Insert table">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
    </button>
    <button data-format="tasklist" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Task List" aria-label="Insert task list">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    </button>
    <button data-format="blockquote" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Blockquote" aria-label="Insert blockquote">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
    </button>
    <button data-format="footnote" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Footnote" aria-label="Insert footnote">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17a5 5 0 0 0 5-5"/><path d="M12 17a5 5 0 0 1-5-5"/><path d="M12 17v4"/><path d="M12 3v4"/><path d="M7 7a5 5 0 0 1 5-5"/><path d="M17 7a5 5 0 0 0-5-5"/></svg>
    </button>
    <button data-format="hr" class="format-btn bg-slate-700 hover:bg-slate-600 text-slate-200 hover:text-white p-1.5 rounded transition-colors flex-shrink-0" title="Horizontal Rule" aria-label="Insert horizontal rule">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </button>
  </div>
  <!-- Right Group: Color Swatches -->
  <div id="color-swatches-container" class="flex items-center flex-shrink-0 w-full sm:w-auto sm:ml-auto whitespace-nowrap">
    <ColorSwatches currentColor="#0f172a" />
  </div>
</div>
