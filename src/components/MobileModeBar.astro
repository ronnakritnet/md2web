<!-- Mobile Mode Toggle Bar -->
<div class="block md:hidden w-full bg-gray-800 border-b border-gray-700">
  <div class="flex">
    <button 
      id="mobile-edit-btn"
      class="flex-1 py-3 text-sm font-medium transition-colors bg-green-600 text-white"
      aria-label="Edit mode"
    >
      Edit
    </button>
    <button 
      id="mobile-preview-btn"
      class="flex-1 py-3 text-sm font-medium transition-colors bg-slate-700 text-slate-300 hover:bg-slate-600"
      aria-label="Preview mode"
    >
      Preview
    </button>
  </div>
</div>
