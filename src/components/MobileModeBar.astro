---
---
<!-- Mobile Mode Toggle Bar -->
<div class="block md:hidden w-full bg-gray-800 border-b border-gray-700 px-4 py-2">
  <div class="flex justify-center items-center">
    <div class="flex items-center gap-2 max-w-[240px] p-0.5 bg-gray-900/60 border border-gray-700/60 rounded-lg mx-auto my-1.5 w-full">
      <button
        id="mobile-edit-btn"
        class="w-1/2 flex items-center justify-center gap-2 py-1.5 px-3 text-xs font-semibold rounded-md bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 shadow-sm pointer-events-none"
        aria-label="Edit mode"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
        Edit
      </button>
      <button
        id="mobile-preview-btn"
        class="w-1/2 flex items-center justify-center gap-2 py-1.5 px-3 text-xs font-medium rounded-md text-gray-400 hover:text-gray-200 bg-transparent border-transparent"
        aria-label="Preview mode"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        Preview
      </button>
    </div>
  </div>
</div>
